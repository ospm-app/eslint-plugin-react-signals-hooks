{
  "name": "@ospm/eslint-plugin-react-three-fiber",
  "version": "1.0.0",
  "description": "ESLint plugin for React Three Fiber - enforces best practices and patterns for 3D graphics with React Three Fiber",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./rules": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:cjs && bun run build:esm && bun run build:types",
    "build:cjs": "bun x tsc --project tsconfig.cjs.json",
    "build:esm": "bun x tsc --project tsconfig.esm.json",
    "build:types": "bun x tsc --project tsconfig.types.json",
    "build:watch": "bun run build:cjs -- --watch & bun run build:esm -- --watch & bun run build:types -- --watch",
    "clean": "rm -rf dist/",
    "prebuild": "bun run clean",
    "test": "bun run build && bun run test:all-rules",
    "test:all-rules": "echo \"No tests configured yet\"",
    "lint": "bun x eslint src/ --ext .ts",
    "lint:fix": "bun x eslint src/ --ext .ts --fix",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react",
    "three",
    "threejs",
    "r3f",
    "react-three-fiber",
    "3d",
    "graphics"
  ],
  "author": {
    "name": "Alexey Lyakhov",
    "url": "https://github.com/JustFly1984",
    "email": "justfly1984@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ospm-app/eslint-plugin-react-signals-hooks/tree/main/packages/eslint-plugin-react-three-fiber"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/estree": "^1.0.8",
    "@typescript-eslint/utils": "^8.39.1"
  },
  "devDependencies": {
    "@ospm/eslint-plugin-eslint-rule": "workspace:*",
    "@biomejs/biome": "^2.1.4",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "eslint": ">=8.57.1 || ^9.33.0",
    "typescript": ">=5.9.2"
  }
}
